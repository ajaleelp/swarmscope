# Copy this file to .env before starting local services.
# The real .env is ignored by Git and must only contain local development values.
SWARMSCOPE_POSTGRES_USER=swarmscope
SWARMSCOPE_POSTGRES_PASSWORD=replace-with-local-password
SWARMSCOPE_POSTGRES_DB=swarmscope
SWARMSCOPE_POSTGRES_PORT=5432

# From: terraform output service_bus_fully_qualified_namespace
SWARMSCOPE_SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=replace-with-your-namespace.servicebus.windows.net
SWARMSCOPE_SERVICE_BUS_TOPIC=orders
SWARMSCOPE_SERVICE_BUS_SUBSCRIPTION=fulfilment
